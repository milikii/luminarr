# 当前 cleanup 验证窗口提示：
# - 如果你只想启动 Transmission / Emby 本地测试栈，不需要填写这个文件
# - 只为启动 Luminarr 并做最小本地测试，至少填写：
#   TELEGRAM_BOT_TOKEN / PROWLARR_BASE_URL / PROWLARR_API_KEY / TRANSMISSION_BASE_URL
# - 如果还要验证导入和媒体库刷新，再补：
#   LIBRARY_TARGET_DIR / EMBY_BASE_URL / EMBY_API_KEY
# - TMDB / Fanart / 字幕翻译当前都不是启动硬必填；缺少时只会关闭对应增强能力
# - 如果要补 Feishu / WeCom 真实私聊 smoke，再补各自凭据
# - personal WeChat 依赖本地登录态，不在这里填写专用环境变量

# Telegram 私聊入口
# 当前启动真相里这是硬必填；不填应用不会启动
TELEGRAM_BOT_TOKEN=
# Prowlarr 搜索入口地址；最小本地测试必填
PROWLARR_BASE_URL=http://127.0.0.1:9696
# Prowlarr API Key；最小本地测试必填
PROWLARR_API_KEY=

# 元数据来源
# TMDB 服务地址；一般保持默认即可
TMDB_BASE_URL=https://api.themoviedb.org
# TMDB API Key；当前不是启动硬必填；只有要补 TMDB 识别、metadata scraping 或 BT 影视关联时再填
TMDB_API_KEY=
# Fanart.tv 服务地址；一般保持默认即可
FANART_BASE_URL=https://webservice.fanart.tv/v3
# Fanart.tv API Key；只在你要补海报/背景图时填写
FANART_API_KEY=

# 默认下载器（当前单实例直连变量只支持 Transmission）
# 当前启动真相里 TRANSMISSION_BASE_URL 仍然是硬必填；就算启用了 DOWNLOADER_INSTANCES 也不能省略
TRANSMISSION_BASE_URL=http://127.0.0.1:19091
# Transmission 用户名；当前本地测试栈默认可留空
TRANSMISSION_USERNAME=
# Transmission 密码；当前本地测试栈默认可留空
TRANSMISSION_PASSWORD=

# 可选的多下载器路由
# 只有在你要同时配置多个下载器实例时才填写
# 格式：name|type|base_url|download_dir 或 name|type|base_url|download_dir|username|password
# name 是实例别名；type 目前写 transmission 或 qbittorrent；download_dir 要写下载器真实落盘目录（WSL 宿主机视角）
# 多个实例用 ; 分隔；这组配置用于补充路由，不会替代上面的 TRANSMISSION_BASE_URL
DOWNLOADER_INSTANCES=
# PT 主链默认走哪个实例名；值必须和 DOWNLOADER_INSTANCES 里的 name 完全一致；不填时默认取第一个实例名
PT_DOWNLOADER=
# BT 主链默认走哪个实例名；值必须和 DOWNLOADER_INSTANCES 里的 name 完全一致；不填时默认取第一个实例名
BT_DOWNLOADER=

# 导入与媒体库路径
# 导入目标目录；要跑 import / refresh 联调时必填
LIBRARY_TARGET_DIR=/data/library/movies
# SQLite 数据库文件路径；一般保持默认即可
SQLITE_DB_PATH=./data/luminarr.db
# 下载器和媒体库共享根目录；主要给 docker-compose.yml 展开宿主机挂载；本地 Python 运行时不会直接读取这项
SHARED_MEDIA_ROOT=/data
# 本地状态目录；只给 docker-compose.yml 展开宿主机挂载到容器内 /app/state
LUMINARR_STATE_DIR=./data
# 本地日志目录；只给 docker-compose.yml 展开宿主机挂载到容器内 /app/logs
LUMINARR_LOG_DIR=./logs

# 媒体服务器（当前主线是 Emby）
# Emby 地址；要跑 import / refresh 联调时必填
EMBY_BASE_URL=http://127.0.0.1:18096
# Emby API Key；要跑 import / refresh 联调时必填
EMBY_API_KEY=

# 字幕翻译（当前仅用于字幕自动翻译）
# API Key；只有启用字幕翻译时才填写
SUBTITLE_TRANSLATION_API_KEY=
# 字幕翻译服务地址；一般保持默认即可
SUBTITLE_TRANSLATION_BASE_URL=https://api.openai.com/v1
# 字幕翻译模型；一般保持默认即可
SUBTITLE_TRANSLATION_MODEL=gpt-5.4
# 字幕翻译超时秒数；默认 60 秒；远端接口慢或字幕较长时可以适当调大
SUBTITLE_TRANSLATION_TIMEOUT_SECONDS=60

# BT-only 额外配置
# 纯 BT 目标目录；格式：key|target_dir 或 key|label|target_dir，多个用 ; 分隔
# key 是用户回复时选用的短键；label 是展示给用户看的中文名；target_dir 是宿主机真实目标目录
RAW_BT_DESTINATIONS=
# BT 外站来源键；多个用 , 分隔；例如 nyaa,javdb；留空表示只走 Prowlarr，不启用 BT 外站抓取
BT_WEB_SOURCES=

# Feishu 私聊 webhook
# 只有你要跑 Feishu 真实私聊 smoke 时才填写；值来自 Feishu Open Platform 应用凭据；这三个键要么都空，要么都填
FEISHU_APP_ID=
# Feishu 应用密钥；和 FEISHU_APP_ID 成对使用；不要提交到仓库
FEISHU_APP_SECRET=
# Feishu 加密 key；用于当前 webhook 验签；必须和 Feishu 事件订阅配置保持一致
FEISHU_ENCRYPT_KEY=
# Feishu Open Platform 基础地址；一般保持默认即可
FEISHU_BASE_URL=https://open.feishu.cn
# Feishu webhook 监听地址；只影响本机监听，不是公网回调地址；本地运行通常保持默认即可
FEISHU_WEBHOOK_HOST=0.0.0.0
# Feishu webhook 监听端口；要和你暴露给 Feishu 的本地/反向代理端口保持一致
FEISHU_WEBHOOK_PORT=18095
# Feishu webhook 路径；要和事件订阅里填写的路径保持一致
FEISHU_WEBHOOK_PATH=/feishu/webhook

# WeCom 私聊 webhook
# 只有你要跑 WeCom 真实私聊 smoke 时才填写；值来自企业微信回调配置页；这三个键要么都空，要么都填
WECOM_TOKEN=
# WeCom AES key；企业微信回调里的 EncodingAESKey；必须和回调配置保持一致
WECOM_ENCODING_AES_KEY=
# WeCom receive id；通常是企业 ID / CorpID；用于校验并生成回包
WECOM_RECEIVE_ID=
# WeCom webhook 监听地址；只影响本机监听，不是公网回调地址；本地运行通常保持默认即可
WECOM_WEBHOOK_HOST=0.0.0.0
# WeCom webhook 监听端口；要和你暴露给企业微信的本地/反向代理端口保持一致
WECOM_WEBHOOK_PORT=18097
# WeCom webhook 路径；要和企业微信回调 URL 路径保持一致
WECOM_WEBHOOK_PATH=/wecom/webhook
