# 当前 quick start 提示：
# - 只想启动 Luminarr 并做最小 Telegram 本地测试，先填 [1]
# - 还要验证导入和媒体库刷新，再补 [2]
# - 想开多下载器、BT-only、字幕翻译、Feishu、WeCom 时，再补对应分组
# - personal WeChat 依赖本地登录态，不靠这里的专用环境变量启动

# =============================================
# [1] 启动最小集（启动硬必填 / 推荐默认值）
# =============================================
# [必填] 当前启动真相里这是硬必填；不填应用不会启动
TELEGRAM_BOT_TOKEN=
# [必填] Prowlarr 搜索入口地址；最小本地测试必填
PROWLARR_BASE_URL=http://127.0.0.1:9696
# [必填] Prowlarr API Key；最小本地测试必填
PROWLARR_API_KEY=
# [必填] 当前单实例直连变量只支持 Transmission；即使启用了 DOWNLOADER_INSTANCES 也不能省略
TRANSMISSION_BASE_URL=http://127.0.0.1:19091
# [可选] Transmission 用户名；当前本地测试栈默认可留空
TRANSMISSION_USERNAME=
# [可选] Transmission 密码；当前本地测试栈默认可留空
TRANSMISSION_PASSWORD=

# =============================================
# [2] 导入 / 刷新 / 本地状态路径（跑 import / refresh 时条件必填）
# =============================================
# [条件必填] 导入目标目录；要跑 import / refresh 联调时必填
LIBRARY_TARGET_DIR=/data/library/movies
# [条件必填] Emby 地址；要跑 import / refresh 联调时必填
EMBY_BASE_URL=http://127.0.0.1:18096
# [条件必填] Emby API Key；要跑 import / refresh 联调时必填
EMBY_API_KEY=
# [可选] SQLite 数据库文件路径；一般保持默认即可
SQLITE_DB_PATH=./data/luminarr.db
# [可选] 下载器和媒体库共享根目录；主要给 docker-compose.yml 展开宿主机挂载
SHARED_MEDIA_ROOT=/data
# [可选] 本地状态目录；给 docker-compose.yml 挂到容器内 /app/state
LUMINARR_STATE_DIR=./data
# [可选] 本地日志目录；给 docker-compose.yml 挂到容器内 /app/logs，本地 Python 运行也默认写这里
LUMINARR_LOG_DIR=./logs

# =============================================
# [3] 元数据增强（可选）
# =============================================
# [可选] TMDB 服务地址；一般保持默认即可
TMDB_BASE_URL=https://api.themoviedb.org
# [可选] TMDB API Key；不填时只关闭 TMDB 相关增强能力
TMDB_API_KEY=
# [可选] Fanart.tv 服务地址；一般保持默认即可
FANART_BASE_URL=https://webservice.fanart.tv/v3
# [可选] Fanart.tv API Key；只在你要补海报 / 背景图时填写
FANART_API_KEY=

# =============================================
# [4] 网络与下载器扩展（按需）
# =============================================
# [可选] 给 Telegram / TMDB / Fanart / BT 外站 / 字幕翻译这类公网请求使用；本地或内网地址仍直连
OUTBOUND_PROXY_URL=
# [条件必填] 只有在你要同时配置多个下载器实例时才填写
# 格式：name|type|base_url|download_dir 或 name|type|base_url|download_dir|username|password
# 多个实例用 ; 分隔；这组配置用于补充路由，不会替代上面的 TRANSMISSION_BASE_URL
DOWNLOADER_INSTANCES=
# [条件必填] PT 主链默认走哪个实例名；值必须和 DOWNLOADER_INSTANCES 里的 name 完全一致
PT_DOWNLOADER=
# [条件必填] BT 主链默认走哪个实例名；值必须和 DOWNLOADER_INSTANCES 里的 name 完全一致
BT_DOWNLOADER=

# =============================================
# [5] 字幕翻译与 BT-only 扩展（按需）
# =============================================
# [条件必填] 只有启用字幕翻译时才填写
SUBTITLE_TRANSLATION_API_KEY=
# [可选] 字幕翻译服务地址；一般保持默认即可
SUBTITLE_TRANSLATION_BASE_URL=https://api.openai.com/v1
# [可选] 字幕翻译模型；一般保持默认即可
SUBTITLE_TRANSLATION_MODEL=gpt-5.4
# [可选] 字幕翻译超时秒数；默认 60 秒
SUBTITLE_TRANSLATION_TIMEOUT_SECONDS=60
# [条件必填] 纯 BT 目标目录；格式：key|target_dir 或 key|label|target_dir，多个用 ; 分隔
RAW_BT_DESTINATIONS=
# [可选] BT 外站来源键；多个用 , 分隔；留空表示只走 Prowlarr
BT_WEB_SOURCES=

# =============================================
# [6] Feishu 私聊入口（按需）
# =============================================
# [可选] 入站模式；默认 webhook；如果不想折腾公网 HTTPS 回调，可改成 long_connection
FEISHU_INBOUND_MODE=webhook
# [条件必填] 只有你要跑 Feishu 真实私聊 smoke 时才填写；默认 webhook 模式下这三个键要么都空，要么都填
FEISHU_APP_ID=
# [条件必填] Feishu 应用密钥；和 FEISHU_APP_ID 成对使用；不要提交到仓库
FEISHU_APP_SECRET=
# [条件必填] Feishu 加密 key；用于 webhook 验签；如果 FEISHU_INBOUND_MODE=long_connection，可保留为空
FEISHU_ENCRYPT_KEY=
# [可选] Feishu Open Platform 基础地址；一般保持默认即可
FEISHU_BASE_URL=https://open.feishu.cn
# [可选] Feishu webhook 监听地址；只影响本机监听，不是公网回调地址
FEISHU_WEBHOOK_HOST=0.0.0.0
# [可选] Feishu webhook 监听端口；要和你暴露给 Feishu 的本地 / 反向代理端口保持一致
FEISHU_WEBHOOK_PORT=18095
# [可选] Feishu webhook 路径；要和事件订阅里填写的路径保持一致
FEISHU_WEBHOOK_PATH=/feishu/webhook

# =============================================
# [7] WeCom 私聊入口（按需）
# =============================================
# [条件必填] 只有你要跑 WeCom 真实私聊 smoke 时才填写；这三个键要么都空，要么都填
WECOM_TOKEN=
# [条件必填] WeCom AES key；企业微信回调里的 EncodingAESKey；必须和回调配置保持一致
WECOM_ENCODING_AES_KEY=
# [条件必填] WeCom receive id；通常是企业 ID / CorpID；用于校验并生成回包
WECOM_RECEIVE_ID=
# [可选] WeCom webhook 监听地址；只影响本机监听，不是公网回调地址
WECOM_WEBHOOK_HOST=0.0.0.0
# [可选] WeCom webhook 监听端口；要和你暴露给企业微信的本地 / 反向代理端口保持一致
WECOM_WEBHOOK_PORT=18097
# [可选] WeCom webhook 路径；要和企业微信回调 URL 路径保持一致
WECOM_WEBHOOK_PATH=/wecom/webhook
